        <mxCell id="note_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;strokeWidth=1;fontColor=#9A3412;fontSize=11;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" value="&lt;b&gt;边界约束&lt;/b&gt;&lt;br&gt;· ORM / Session 不越过 Service&lt;br&gt;· 不进入 HTTP 响应或 Celery 消息&lt;br&gt;· Celery 只带 file_id / library_id /&lt;br&gt;&amp;nbsp;&amp;nbsp;tenant_id / trace_id 等标识&lt;br&gt;· Worker 重读 ORM 并校验租户关系&lt;br&gt;· MySQL 与 MinIO/ES/Milvus 非同一事务" vertex="1">
